generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Servicer {
  aliseda
  servihabitat
  haya
  altamira
  solvia
  anticipa
  diglo
  hipoges
  buildingcenter
}

enum PropertyType {
  piso
  casa
  chalet
  atico
  estudio
  duplex
  local
  oficina
  nave
  garaje
  trastero
  suelo_urbano
  suelo_rustico
  edificio
}

enum PropertyStatus {
  disponible
  reservado
  vendido
  delisted
}

enum GeocodeConfidence {
  high
  medium
  low
  pending
}

model Property {
  id                 String            @id @default(uuid())
  externalId         String
  servicer           Servicer
  title              String
  description        String?           @db.Text
  price              Int // cents (euros*100) — canonical in v2, API exposes euros
  propertyType       PropertyType
  status             PropertyStatus    @default(disponible)
  addressRaw         String?
  addressNormalized  String?
  province           String?
  municipality       String?
  postalCode         String?
  neighborhood       String?
  latitude           Float
  longitude          Float
  geocodeConfidence  GeocodeConfidence @default(medium)
  approximateLocation Boolean          @default(false)
  geocodeProvider    String?
  areaM2             Float?
  rooms              Int?
  bathrooms          Int?
  yearBuilt          Int?
  energyCert         String?
  photos             Json              @default("[]")
  sourceUrl          String
  rawPayloadHash     String?
  lastSeenAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  delistedAt         DateTime?

  priceHistory  PriceHistory[]
  statusHistory StatusHistory[]
  favorites     Favorite[]
  alerts        Alert[]

  @@unique([servicer, externalId])
  @@index([province, municipality])
  @@index([price])
  @@index([propertyType])
  @@index([status])
  @@index([latitude, longitude])
  @@index([servicer])
}

model PriceHistory {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  price      Int
  date       DateTime @default(now())

  @@index([propertyId, date])
}

model StatusHistory {
  id         String         @id @default(uuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status     PropertyStatus
  date       DateTime       @default(now())

  @@index([propertyId, date])
}

model GeocodeCache {
  id               String   @id @default(uuid())
  normalizedHash   String   @unique
  normalizedAddress String
  latitude         Float
  longitude        Float
  province         String?
  municipality     String?
  postalCode       String?
  neighborhood     String?
  provider         String?
  confidence       GeocodeConfidence
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
}

model IngestJob {
  id           String    @id @default(uuid())
  servicer     Servicer
  status       String // queued, running, success, partial_failure, failed
  startedAt    DateTime? @default(now())
  finishedAt   DateTime?
  ingested     Int       @default(0)
  created      Int       @default(0)
  updated      Int       @default(0)
  delisted     Int       @default(0)
  failed       Int       @default(0)
  error        String?   @db.Text
  createdAt    DateTime  @default(now())
  usedPlaywright Boolean @default(false)

  @@index([servicer, createdAt])
}

// Auth.js / NextAuth models
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  savedSearches SavedSearch[]
  favorites     Favorite[]
  alerts        Alert[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Domain: saved searches / favorites / alerts
model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filters   Json // {priceMin, priceMax, province, servicer[], bbox, etc}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([userId, createdAt])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model Alert {
  id            String   @id @default(uuid())
  userId        String
  savedSearchId String?
  propertyId    String
  type          String // new_listing | price_drop
  payload       Json? // {oldPrice, newPrice}
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([propertyId])
}
