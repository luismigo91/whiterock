generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Servicer {
  aliseda
  servihabitat
  haya
  altamira
  solvia
  anticipa
  diglo
  hipoges
  buildingcenter
}

enum PropertyType {
  piso
  casa
  chalet
  atico
  estudio
  duplex
  local
  oficina
  nave
  garaje
  trastero
  suelo_urbano
  suelo_rustico
  edificio
}

enum PropertyStatus {
  disponible
  reservado
  vendido
  delisted
}

enum GeocodeConfidence {
  high
  medium
  low
  pending
}

model Property {
  id                 String            @id @default(uuid())
  externalId         String
  servicer           Servicer
  title              String
  description        String?           @db.Text
  price              Int // cents? store as euros * 100? spec says cents; we store Int euros for simplicity (use cents)
  propertyType       PropertyType
  status             PropertyStatus    @default(disponible)
  addressRaw         String?
  addressNormalized  String?
  province           String?
  municipality       String?
  postalCode         String?
  neighborhood       String?
  latitude           Float
  longitude          Float
  geocodeConfidence  GeocodeConfidence @default(medium)
  approximateLocation Boolean          @default(false)
  geocodeProvider    String?
  areaM2             Float?
  rooms              Int?
  bathrooms          Int?
  yearBuilt          Int?
  energyCert         String?
  photos             Json              @default("[]")
  sourceUrl          String
  rawPayloadHash     String?
  lastSeenAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  delistedAt         DateTime?

  priceHistory  PriceHistory[]
  statusHistory StatusHistory[]

  @@unique([servicer, externalId])
  @@index([province, municipality])
  @@index([price])
  @@index([propertyType])
  @@index([status])
  @@index([latitude, longitude])
  @@index([servicer])
}

model PriceHistory {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  price      Int
  date       DateTime @default(now())

  @@index([propertyId, date])
}

model StatusHistory {
  id         String         @id @default(uuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status     PropertyStatus
  date       DateTime       @default(now())

  @@index([propertyId, date])
}

model GeocodeCache {
  id               String   @id @default(uuid())
  normalizedHash   String   @unique
  normalizedAddress String
  latitude         Float
  longitude        Float
  province         String?
  municipality     String?
  postalCode       String?
  neighborhood     String?
  provider         String?
  confidence       GeocodeConfidence
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
}

model IngestJob {
  id           String    @id @default(uuid())
  servicer     Servicer
  status       String    // queued, running, success, partial_failure, failed
  startedAt    DateTime? @default(now())
  finishedAt   DateTime?
  ingested     Int       @default(0)
  created      Int       @default(0)
  updated      Int       @default(0)
  delisted     Int       @default(0)
  failed       Int       @default(0)
  error        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([servicer, createdAt])
}
