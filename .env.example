# Database
DATABASE_URL="postgresql://user:password@localhost:5432/whiterock?schema=public"
# Direct URL for Prisma Migrate (if using PgBouncer)
# DIRECT_URL="postgresql://user:password@localhost:5432/whiterock?schema=public"

# Redis (for BullMQ) - optional, falls back to in-memory queue
REDIS_URL="redis://localhost:6379"

# Geocoding
GEOCODER_PRIMARY="nominatim" # nominatim | google
GEOCODER_GOOGLE_API_KEY=""
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Ingest
INGEST_RATE_LIMIT_RPS="1"
INGEST_CRON_DAILY="0 3 * * *"
INGEST_CRON_INCREMENTAL="0 */6 * * *"

# Next
NEXT_PUBLIC_MAP_TILES="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Auth / Alerts / Cron (v2)
NEXTAUTH_SECRET="change-me-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="dev-cron-secret"
ADMIN_EMAILS="admin@whiterock.es"
SLACK_WEBHOOK_URL=""
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_FROM="noreply@whiterock.es"
SMTP_USER=""
SMTP_PASS=""
